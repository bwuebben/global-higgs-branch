# Public release allowlist; build products and unlisted files stay local.
*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CITATION.cff
!/CITATION.bib
!/Makefile
!/requirements.txt
!/papers/
!/papers/01-global-constraints/
!/papers/02-quantum-transition/
!/papers/03-magnetic-sheaves/
!/papers/*/README.md
!/papers/*/paper.pdf
!/papers/*/main.tex
!/papers/*/sections/
!/papers/*/sections/*.tex
!/papers/01-global-constraints/figures/
!/papers/01-global-constraints/figures/*.tex
!/shared/
!/shared/README.md
!/shared/macros.tex
!/shared/bibliography/
!/shared/bibliography/*.bib
!/shared/tex/
!/shared/tex/jheppub.sty
!/shared/tex/JHEP.bst
!/scripts/
!/scripts/build.sh
!/scripts/check.sh
!/checks/
!/checks/README.md
!/checks/REFERENCE.md
!/checks/*.py
!/checks/*.sage
/checks/*.sage.py
